{
  "name": "@gum-jsx/math",
  "version": "1.8.2",
  "description": "LaTeX math elements and rendering for gum.jsx",
  "type": "module",
  "author": "Douglas Hanley",
  "homepage": "https://github.com/CompendiumLabs/gum-jsx-math",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/gum-jsx-math.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "docs",
    "types"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.ts"
    },
    "./fonts": {
      "types": "./types/fonts.d.ts",
      "import": "./src/fonts.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "bun tsc --noEmit",
    "types": "rm -rf types && bun tsc -p tsconfig.types.json && cp -r src/types types/types",
    "prepublishOnly": "bun run types"
  },
  "peerDependencies": {
    "@gum-jsx/core": "^1.8.0"
  },
  "dependencies": {
    "katex": "^0.16.33"
  },
  "devDependencies": {
    "@gum-jsx/core": "^1.8.0",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  }
}
